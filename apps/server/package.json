{
  "name": "@bursar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "bursar": "tsx src/cli.ts"
  },
  "dependencies": {
    "@bursar/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
